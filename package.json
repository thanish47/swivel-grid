{
  "name": "swivel-grid",
  "version": "1.0.1",
  "description": "A framework-agnostic data grid Web Component with a hook-based extension system, bundle loader, and row virtualization.",
  "type": "module",
  "main": "SwivelGrid.js",
  "module": "dist/swivel-grid.esm.js",
  "types": "SwivelGrid.d.ts",
  "unpkg": "dist/swivel-grid.umd.cjs",
  "jsdelivr": "dist/swivel-grid.umd.cjs",
  "exports": {
    ".": {
      "import": "./SwivelGrid.js",
      "require": "./dist/swivel-grid.umd.cjs",
      "types": "./SwivelGrid.d.ts",
      "default": "./SwivelGrid.js"
    },
    "./extensions/*": {
      "import": "./extensions/*.js",
      "types": "./extensions/*.d.ts"
    },
    "./bundles/*": {
      "import": "./bundles/*.js",
      "types": "./bundles/*.d.ts"
    },
    "./types": {
      "import": "./types.d.ts",
      "types": "./types.d.ts"
    }
  },
  "files": [
    "SwivelGrid.js",
    "SwivelGrid.d.ts",
    "types.d.ts",
    "schema-column.schema.json",
    "llms.txt",
    "llms-full.txt",
    "dist/",
    "extensions/",
    "bundles/",
    "README.md",
    "CHANGELOG.md",
    "API_REFERENCE.md",
    "ARCHITECTURE.md",
    "BUNDLE_SYSTEM_GUIDE.md",
    "PERFORMANCE_GUIDE.md",
    "VIRTUALIZATION_GUIDE.md",
    "COLUMN_TYPES_TO_TEMPLATES_MIGRATION.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "npm run build && npm test",
    "build": "vite build",
    "start": "python -m http.server 4400",
    "serve": "python3 -m http.server 4400",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "web-components",
    "grid",
    "data-grid",
    "table",
    "swivel",
    "html",
    "javascript",
    "extension-system"
  ],
  "author": "Tanish Alaparthi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thanish/swivel-grid"
  },
  "homepage": "https://swivelgrid.thanish.com/",
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
